# Frontend Dockerfile for Railway deployment
# This Dockerfile builds the React app and serves it with Nginx

# Stage 1: Build React app
FROM node:20-alpine AS build

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm ci

# Copy source code
COPY . .

# Build the application (with API base URL from build arg)
# Allow REACT_APP_API_BASE to be passed as a build arg or use Railway environment variable
ARG REACT_APP_API_BASE
ENV REACT_APP_API_BASE=${REACT_APP_API_BASE:-}
RUN npm run build

# Stage 2: Serve with Nginx
FROM nginx:alpine

# Copy custom Nginx config
COPY nginx.conf.railway /etc/nginx/conf.d/default.conf.template

# Copy build files from previous stage
COPY --from=build /app/build /usr/share/nginx/html

# Install gettext for envsubst
RUN apk add --no-cache gettext

# Expose port (Railway uses dynamic ports via $PORT environment variable)
EXPOSE 80

# Start Nginx with environment variables substituted
CMD ["sh", "-c", "envsubst '$PORT' < /etc/nginx/conf.d/default.conf.template > /etc/nginx/conf.d/default.conf && nginx -g 'daemon off;'"]